# ---- Browser (Vite, safe to expose) ----
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=
# Optional: origin used by the hosted app in smoke tests
APP_ORIGIN=

# ---- Local PostgreSQL / tests ----
# Local Docker example:
# docker run --name paperlab-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=paperlab -p 5433:5432 -d postgres:16
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/paperlab
PGHOST=
PGPORT=5432
PGDATABASE=paperlab
PGUSER=
PGPASSWORD=
PGSSL=false

# ---- platform-api runtime (server only, never VITE_*) ----
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:4173
# openai | fixture (fixture is refused unless APP_ENV=test)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000
AI_RESULT_MAX_BYTES=5000000
# Text planner (Wave B). AI_TEXT_PROVIDER=fixture is test-only.
AI_TEXT_PROVIDER=openai
AI_TEXT_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini
AI_TEXT_BASE_URL=https://api.openai.com/v1
AI_PLAN_USER_PER_MINUTE=3
AI_PLAN_USER_PER_DAY=30
AI_PLAN_TENANT_PER_DAY=200
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_V3_KEY=
# Test-only identity secret for the local Playwright harness
TEST_AUTH_SECRET=local-e2e-secret-not-for-production

# ---- CloudBase deployment ----
TCB_ENV_ID=
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_REGION=ap-shanghai
